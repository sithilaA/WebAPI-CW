# Copy to .env for local use. Never commit .env.
PORT=3000
# Production behind nginx: HOST=127.0.0.1 (only the reverse proxy can reach the API)
HOST=

# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) stored in .data/pglite.
# In production set it to a hosted PostgreSQL connection string.
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10

# REQUIRED in production. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Password given to every seeded SLSEA user. If empty, the seed script generates one
# and writes it to seed-output/users.json.
SEED_PASSWORD=

INGEST_RATE_LIMIT_PER_MIN=60
LOGIN_RATE_LIMIT_PER_MIN=10
